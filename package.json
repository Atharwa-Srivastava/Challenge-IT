{
  "name": "kahoot-clone",
  "version": "1.0.0",
  "description": "Full-stack real-time Kahoot clone built with Node.js, Express, Socket.io, React, and Tailwind CSS",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "build": "cd client && npm install && npm run build",
    "dev:server": "node server/index.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "test": "node server/testGameFlow.js"
  },
  "keywords": [
    "kahoot",
    "quiz",
    "socket.io",
    "react",
    "multiplayer",
    "realtime"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
